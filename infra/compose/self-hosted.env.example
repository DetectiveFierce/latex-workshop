WEB_ORIGIN=https://mind-palace.example-tailnet.ts.net
API_ORIGIN=https://mind-palace.example-tailnet.ts.net
S3_PUBLIC_ENDPOINT=https://mind-palace.example-tailnet.ts.net:8443
SMTP_FROM=LaTeX Workshop <noreply@latex-workshop.local>

POSTGRES_USER=latex
POSTGRES_PASSWORD=generate-a-unique-hex-secret
POSTGRES_DB=latex_workshop
MINIO_ROOT_USER=minio-root
MINIO_ROOT_PASSWORD=generate-a-different-hex-secret
S3_ACCESS_KEY=latex-app
S3_SECRET_KEY=generate-a-third-hex-secret
AUTH_SECRET=generate-at-least-32-random-bytes
MAX_PROJECTS_PER_USER=250

SERVICE_IMAGE=latex-workshop-services:release-id
WEB_IMAGE=latex-workshop-web:release-id
TEXLIVE_IMAGE=latex-workshop-texlive:release-id
DOCKER_GID=988
BACKUP_UID=1000
BACKUP_GID=1000
COMPILE_WORK_DIR=/home/mind-palace/services/latex-workshop/runtime/compile-tmp
BACKUP_STAGE_DIR=/home/mind-palace/services/latex-workshop/runtime/backup-stage
