{
  "name": "@latex-workshop/compile-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@latex-workshop/config": "workspace:*",
    "@latex-workshop/contracts": "workspace:*",
    "@latex-workshop/db": "workspace:*",
    "@latex-workshop/storage": "workspace:*",
    "bullmq": "6.3.1",
    "drizzle-orm": "0.45.2",
    "ioredis": "5.7.0"
  },
  "devDependencies": {
    "tsx": "4.20.5"
  }
}
