{
  "name": "@latex-workshop/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/templates && cp -R src/templates/. dist/templates/",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.2",
    "@better-auth/core": "1.7.2",
    "@better-auth/mcp": "1.7.2",
    "@better-auth/oauth-provider": "1.7.2",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.1",
    "@fastify/cors": "11.1.0",
    "@fastify/formbody": "8.0.2",
    "@fastify/helmet": "13.0.1",
    "@fastify/multipart": "9.2.1",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/swagger": "9.5.1",
    "@fastify/swagger-ui": "6.1.1",
    "@latex-workshop/config": "workspace:*",
    "@latex-workshop/contracts": "workspace:*",
    "@latex-workshop/db": "workspace:*",
    "@latex-workshop/storage": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "archiver": "7.0.1",
    "better-auth": "1.7.2",
    "better-call": "1.4.0",
    "bullmq": "6.3.1",
    "diff": "8.0.3",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "fastify-plugin": "6.0.0",
    "ioredis": "5.7.0",
    "mime-types": "3.0.1",
    "nodemailer": "9.1.1",
    "yauzl-promise": "4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/mime-types": "3.0.1",
    "@types/nodemailer": "8.0.1",
    "tsx": "4.20.5"
  }
}
